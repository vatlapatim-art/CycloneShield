# Google Earth Engine project used by the real-data pipeline
EARTH_ENGINE_PROJECT=cycloneshield-ai-510103

# Comma-separated browser origins allowed to call FastAPI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini multimodal reasoning (optional; set the hackathon-approved model if required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_RETRY_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional advisory email dispatch (disabled by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_RECIPIENTS=
AUTO_DISPATCH_ENABLED=false
